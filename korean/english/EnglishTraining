<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>VocaMaster - 영어 단어 인터랙티브 스마트 학습기</title>
  <script src="https://cdn.tailwindcss.com/3.4.17"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Pretendard:wght@300;400;500;600;700;800&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet">
  <style>
    body {
      font-family: 'Pretendard', -apple-system, BlinkMacSystemFont, system-ui, Roboto, sans-serif;
    }
    .font-eng {
      font-family: 'Plus Jakarta Sans', -apple-system, sans-serif;
    }
    .perspective-1000 {
      perspective: 1000px;
    }
    .transform-style-3d {
      transform-style: preserve-3d;
    }
    .backface-hidden {
      backface-visibility: hidden;
      -webkit-backface-visibility: hidden;
    }
    .rotate-y-180 {
      transform: rotateY(180deg);
    }
    .custom-scrollbar::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    .custom-scrollbar::-webkit-scrollbar-track {
      background: #f1f5f9;
      border-radius: 9999px;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb {
      background: #cbd5e1;
      border-radius: 9999px;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover {
      background: #94a3b8;
    }
    @keyframes pulse-ring {
      0% { transform: scale(0.95); opacity: 0.8; }
      50% { transform: scale(1.05); opacity: 0.4; }
      100% { transform: scale(0.95); opacity: 0.8; }
    }
    .animate-pulse-ring {
      animation: pulse-ring 2s infinite ease-in-out;
    }
  </style>
</head>
<body class="bg-slate-50 text-slate-800 min-h-screen flex flex-col antialiased selection:bg-indigo-500 selection:text-white">

  <!-- Toast Notification Container -->
  <div id="toast-container" class="fixed top-5 right-5 z-50 flex flex-col gap-2 pointer-events-none"></div>

  <!-- Header -->
  <header class="sticky top-0 z-40 bg-white/90 backdrop-blur-md border-b border-slate-200 shadow-sm transition-all">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-16">
        
        <!-- Brand Logo & Title -->
        <div class="flex items-center gap-3 cursor-pointer" id="brand-logo-btn">
          <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-indigo-600 via-indigo-500 to-purple-500 flex items-center justify-center text-white shadow-md shadow-indigo-200">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
            </svg>
          </div>
          <div>
            <div class="flex items-center gap-2">
              <span class="font-extrabold text-xl tracking-tight bg-gradient-to-r from-indigo-600 to-purple-600 bg-clip-text text-transparent">VocaMaster</span>
              <span class="text-xs px-2 py-0.5 font-semibold bg-indigo-50 text-indigo-600 rounded-full border border-indigo-100">148 Words</span>
            </div>
            <p class="text-xs text-slate-500 hidden sm:block">단어장 • 암기 퀴즈 • 빈칸 쓰기 • 발음 듣기</p>
          </div>
        </div>

        <!-- Global Header Actions -->
        <div class="flex items-center gap-2 sm:gap-3">
          
          <!-- Mastered Count Badge -->
          <div class="flex items-center gap-1.5 px-3 py-1.5 bg-emerald-50 text-emerald-700 rounded-lg text-xs font-semibold border border-emerald-200" title="완벽 암기한 단어 수">
            <svg class="w-4 h-4 text-emerald-500" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
            </svg>
            <span id="header-mastered-count">0</span> / 148
          </div>

          <!-- Starred Count Badge -->
          <button id="header-starred-btn" class="flex items-center gap-1.5 px-3 py-1.5 bg-amber-50 text-amber-700 hover:bg-amber-100 transition rounded-lg text-xs font-semibold border border-amber-200" title="북마크한 단어 모아보기">
            <svg class="w-4 h-4 text-amber-500 fill-amber-500" viewBox="0 0 20 20">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
            </svg>
            <span id="header-starred-count">0</span>
          </button>

          <!-- Audio Settings & Sound FX Toggle -->
          <div class="flex items-center border border-slate-200 rounded-lg p-0.5 bg-slate-100">
            <button id="sound-toggle-btn" class="p-1.5 text-slate-600 hover:text-indigo-600 rounded-md transition" title="효과음 켜기/끄기">
              <svg id="sound-on-icon" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z"></path>
              </svg>
              <svg id="sound-off-icon" class="w-4 h-4 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z"></path>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2"></path>
              </svg>
            </button>
            <select id="tts-speed-select" class="text-xs bg-transparent border-none text-slate-700 py-1 px-1.5 focus:ring-0 cursor-pointer font-medium" title="발음 재생 속도">
              <option value="0.8">0.8x (느리게)</option>
              <option value="1.0" selected>1.0x (보통)</option>
              <option value="1.2">1.2x (빠르게)</option>
            </select>
          </div>

          <!-- Reset / Info Modal Button -->
          <button id="info-modal-btn" class="p-2 text-slate-500 hover:text-slate-800 rounded-lg hover:bg-slate-100 transition" title="학습 방법 및 단축키 안내">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </button>
        </div>

      </div>
    </div>
  </header>

  <!-- Main Container -->
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 w-full flex-1 flex flex-col">
    
    <!-- Navigation Tabs -->
    <div class="flex items-center justify-between border-b border-slate-200 pb-2 mb-6 overflow-x-auto custom-scrollbar">
      <nav class="flex space-x-2 sm:space-x-3" aria-label="Tabs">
        <button id="tab-btn-list" data-tab="list" class="tab-btn active px-4 py-2.5 rounded-xl text-sm font-bold flex items-center gap-2 transition bg-indigo-600 text-white shadow-sm shadow-indigo-200">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16"></path>
          </svg>
          <span>단어 학습장</span>
          <span class="tab-badge bg-indigo-500/30 text-white text-xs px-2 py-0.5 rounded-full" id="list-tab-count">148</span>
        </button>

        <button id="tab-btn-flashcard" data-tab="flashcard" class="tab-btn px-4 py-2.5 rounded-xl text-sm font-medium text-slate-600 hover:text-indigo-600 hover:bg-indigo-50 transition flex items-center gap-2">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
          </svg>
          <span>플래시카드</span>
        </button>

        <button id="tab-btn-quiz" data-tab="quiz" class="tab-btn px-4 py-2.5 rounded-xl text-sm font-medium text-slate-600 hover:text-indigo-600 hover:bg-indigo-50 transition flex items-center gap-2">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          <span>4지선다 퀴즈</span>
        </button>

        <button id="tab-btn-cloze" data-tab="cloze" class="tab-btn px-4 py-2.5 rounded-xl text-sm font-medium text-slate-600 hover:text-indigo-600 hover:bg-indigo-50 transition flex items-center gap-2">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
          </svg>
          <span>빈칸 스펠링</span>
        </button>

        <button id="tab-btn-notes" data-tab="notes" class="tab-btn px-4 py-2.5 rounded-xl text-sm font-medium text-slate-600 hover:text-indigo-600 hover:bg-indigo-50 transition flex items-center gap-2">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
          </svg>
          <span>오답노트 & 북마크</span>
          <span id="notes-badge-count" class="bg-amber-100 text-amber-800 text-xs px-2 py-0.5 rounded-full font-bold">0</span>
        </button>
      </nav>
    </div>

    <!-- Unit Filter Bar (Shared Across Modes) -->
    <div class="bg-white rounded-2xl p-4 shadow-sm border border-slate-200 mb-6">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        
        <!-- Unit Selection Pills -->
        <div class="flex items-center gap-2 overflow-x-auto custom-scrollbar pb-1 md:pb-0">
          <span class="text-xs font-bold text-slate-400 uppercase tracking-wider whitespace-nowrap pl-1">단원 선택:</span>
          <button data-unit="all" class="unit-filter-btn px-3 py-1.5 text-xs font-bold rounded-lg transition whitespace-nowrap bg-indigo-600 text-white">
            전체 (148)
          </button>
          <button data-unit="1" class="unit-filter-btn px-3 py-1.5 text-xs font-semibold rounded-lg transition whitespace-nowrap bg-slate-100 text-slate-600 hover:bg-slate-200">
            Unit 1: 조난•구조 (30)
          </button>
          <button data-unit="2" class="unit-filter-btn px-3 py-1.5 text-xs font-semibold rounded-lg transition whitespace-nowrap bg-slate-100 text-slate-600 hover:bg-slate-200">
            Unit 2: 범죄•과학수사 (31)
          </button>
          <button data-unit="3" class="unit-filter-btn px-3 py-1.5 text-xs font-semibold rounded-lg transition whitespace-nowrap bg-slate-100 text-slate-600 hover:bg-slate-200">
            Unit 3: 생물•신경계 (31)
          </button>
          <button data-unit="4" class="unit-filter-btn px-3 py-1.5 text-xs font-semibold rounded-lg transition whitespace-nowrap bg-slate-100 text-slate-600 hover:bg-slate-200">
            Unit 4: 설화•문화 (28)
          </button>
          <button data-unit="5" class="unit-filter-btn px-3 py-1.5 text-xs font-semibold rounded-lg transition whitespace-nowrap bg-slate-100 text-slate-600 hover:bg-slate-200">
            Unit 5: 환경•지속가능 (28)
          </button>
        </div>

        <!-- Search Input -->
        <div class="relative min-w-[240px]">
          <input type="text" id="global-search-input" placeholder="단어, 뜻 검색..." class="w-full text-xs sm:text-sm pl-9 pr-8 py-2 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 transition">
          <svg class="w-4 h-4 text-slate-400 absolute left-3 top-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
          <button id="clear-search-btn" class="hidden absolute right-2.5 top-2.5 text-slate-400 hover:text-slate-600">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          </button>
        </div>

      </div>
    </div>

    <!-- ==================== TAB 1: 단어 학습장 (Word List) ==================== -->
    <section id="view-list" class="tab-view flex-1 flex flex-col">
      
      <!-- Toolbar Controls -->
      <div class="flex flex-wrap items-center justify-between gap-3 bg-white p-3.5 rounded-xl border border-slate-200 mb-4 shadow-sm">
        
        <!-- Left: Quick Mask Toggles -->
        <div class="flex items-center gap-2">
          <span class="text-xs font-bold text-slate-500 hidden sm:inline">암기 자가진단:</span>
          <button id="toggle-hide-eng" class="px-2.5 py-1.5 text-xs font-semibold rounded-lg border border-slate-300 hover:bg-slate-50 text-slate-700 transition flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21"></path>
            </svg>
            <span id="hide-eng-label">영단어 가리기</span>
          </button>

          <button id="toggle-hide-kor" class="px-2.5 py-1.5 text-xs font-semibold rounded-lg border border-slate-300 hover:bg-slate-50 text-slate-700 transition flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
            </svg>
            <span id="hide-kor-label">한글뜻 가리기</span>
          </button>
        </div>

        <!-- Right: Audio Autoplay & View Layout Toggle -->
        <div class="flex items-center gap-2">
          <button id="btn-autoplay-all" class="px-3 py-1.5 text-xs font-semibold rounded-lg bg-indigo-50 text-indigo-700 hover:bg-indigo-100 transition flex items-center gap-1.5 border border-indigo-200">
            <svg id="autoplay-icon" class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"></path>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <span id="autoplay-label">전체 발음 연속재생</span>
          </button>

          <div class="border-l border-slate-200 h-5 my-auto"></div>

          <div class="flex items-center bg-slate-100 p-0.5 rounded-lg border border-slate-200">
            <button id="layout-cards-btn" class="p-1 rounded text-indigo-600 bg-white shadow-xs" title="카드 보기">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"></path>
              </svg>
            </button>
            <button id="layout-table-btn" class="p-1 rounded text-slate-400 hover:text-slate-600" title="리스트 보기">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
              </svg>
            </button>
          </div>
        </div>

      </div>

      <!-- Word Counter Summary -->
      <div class="flex items-center justify-between text-xs text-slate-500 mb-3 px-1">
        <div>
          표시 중: <strong id="visible-words-count" class="text-slate-700">148</strong>개 단어
        </div>
        <div class="flex items-center gap-3">
          <span class="flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-emerald-500"></span>암기완료</span>
          <span class="flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-amber-400"></span>북마크</span>
          <span class="flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-slate-300"></span>학습중</span>
        </div>
      </div>

      <!-- Word Container (Cards Mode by default) -->
      <div id="word-cards-container" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3.5 mb-8">
        <!-- Dynamically Rendered -->
      </div>

      <!-- Word Table Container (Hidden by default) -->
      <div id="word-table-container" class="hidden bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-sm mb-8">
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse text-sm">
            <thead>
              <tr class="bg-slate-50 border-b border-slate-200 text-xs font-bold text-slate-500 uppercase tracking-wider">
                <th class="py-3 px-4 w-12 text-center">상태</th>
                <th class="py-3 px-4 w-12 text-center">북마크</th>
                <th class="py-3 px-4 w-44">영단어 / 표현</th>
                <th class="py-3 px-4 w-16 text-center">발음</th>
                <th class="py-3 px-4">한글 의미</th>
                <th class="py-3 px-4 w-28 text-center">위치</th>
                <th class="py-3 px-4 hidden md:table-cell">예문</th>
              </tr>
            </thead>
            <tbody id="word-table-body" class="divide-y divide-slate-100">
              <!-- Dynamically Rendered -->
            </tbody>
          </table>
        </div>
      </div>

      <!-- Empty State -->
      <div id="empty-search-state" class="hidden text-center py-16 bg-white rounded-2xl border border-dashed border-slate-200 my-4">
        <svg class="w-12 h-12 text-slate-300 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        <p class="text-slate-600 font-bold mb-1">검색 결과가 없습니다</p>
        <p class="text-xs text-slate-400">철자를 확인하거나 필터를 전체로 변경해 보세요.</p>
      </div>

    </section>

