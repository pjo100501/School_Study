  <!-- Main Application Logic Script -->
  <script>
    (function() {
      'use strict';

      // --- State Management ---
      let state = {
        activeTab: 'list',
        selectedUnit: 'all',
        searchQuery: '',
        layoutMode: 'cards', // 'cards' | 'table'
        hideEnglish: false,
        hideKorean: false,
        soundEnabled: true,
        ttsSpeed: 1.0,
        
        // Progress State (persisted safely in localStorage)
        masteredIds: new Set(),
        starredIds: new Set(),
        mistakeIds: new Set(),
        
        // Flashcard State
        fcIndex: 0,
        fcFlipped: false,
        fcMode: 'eng2kor', // 'eng2kor' | 'kor2eng'
        fcAutoplayTimer: null,
        
        // Word list autoplay state
        listAutoplayIndex: -1,
        listAutoplayTimer: null,

        // Quiz State
        quizActive: false,
        quizType: 'eng2kor',
        quizCount: 20,
        quizItems: [],
        quizCurrentIdx: 0,
        quizScore: 0,
        quizStreak: 0,
        quizMaxStreak: 0,
        quizMissedIds: [],
        quizAnswered: false,

        // Cloze State
        clozeIndex: 0,
        clozeItems: [],
        clozeHintLevel: 0,

        // Notes Subtab
        notesSubtab: 'mistakes' // 'mistakes' | 'starred'
      };

      // Flatten words with unique string IDs
      let allWords = [];
      VOCAB_DATA.forEach(u => {
        u.words.forEach((w, idx) => {
          allWords.push({
            id: `u${u.unitId}_w${idx}`,
            unitId: u.unitId,
            unitTitle: u.title,
            page: w.page,
            word: w.word.trim(),
            meaning: w.meaning.trim(),
            example: w.example || ''
          });
        });
      });

      // Load saved state
      try {
        const savedMastered = localStorage.getItem('voca_mastered');
        if (savedMastered) state.masteredIds = new Set(JSON.parse(savedMastered));
        
        const savedStarred = localStorage.getItem('voca_starred');
        if (savedStarred) state.starredIds = new Set(JSON.parse(savedStarred));
        
        const savedMistakes = localStorage.getItem('voca_mistakes');
        if (savedMistakes) state.mistakeIds = new Set(JSON.parse(savedMistakes));

        const savedSpeed = localStorage.getItem('voca_tts_speed');
        if (savedSpeed) state.ttsSpeed = parseFloat(savedSpeed);

        const savedSound = localStorage.getItem('voca_sound_fx');
        if (savedSound !== null) state.soundEnabled = savedSound === 'true';
      } catch (e) {
        console.warn('Storage unavailable, running in-memory mode', e);
      }

      function persistState() {
        try {
          localStorage.setItem('voca_mastered', JSON.stringify(Array.from(state.masteredIds)));
          localStorage.setItem('voca_starred', JSON.stringify(Array.from(state.starredIds)));
          localStorage.setItem('voca_mistakes', JSON.stringify(Array.from(state.mistakeIds)));
          localStorage.setItem('voca_tts_speed', state.ttsSpeed.toString());
          localStorage.setItem('voca_sound_fx', state.soundEnabled.toString());
        } catch (e) {
          // ignore
        }
        updateHeaderStats();
      }

      // --- Web Audio API Synthesizer (No external sound files) ---
      let audioCtx = null;
      function getAudioContext() {
        if (!audioCtx) {
          const AudioContextClass = window.AudioContext || window.webkitAudioContext;
          if (AudioContextClass) audioCtx = new AudioContextClass();
        }
        if (audioCtx && audioCtx.state === 'suspended') {
          audioCtx.resume();
        }
        return audioCtx;
      }

      function playSound(type) {
        if (!state.soundEnabled) return;
        try {
          const ctx = getAudioContext();
          if (!ctx) return;
          const now = ctx.currentTime;

          if (type === 'correct') {
            // Cheerful chime: C5 -> G5
            const osc1 = ctx.createOscillator();
            const gain1 = ctx.createGain();
            osc1.type = 'sine';
            osc1.frequency.setValueAtTime(523.25, now);
            osc1.frequency.exponentialRampToValueAtTime(783.99, now + 0.15);
            gain1.gain.setValueAtTime(0.15, now);
            gain1.gain.exponentialRampToValueAtTime(0.001, now + 0.35);
            osc1.connect(gain1);
            gain1.connect(ctx.destination);
            osc1.start(now);
            osc1.stop(now + 0.35);
          } else if (type === 'wrong') {
            // Low buzz thud
            const osc = ctx.createOscillator();
            const gain = ctx.createGain();
            osc.type = 'triangle';
            osc.frequency.setValueAtTime(180, now);
            osc.frequency.linearRampToValueAtTime(120, now + 0.25);
            gain.gain.setValueAtTime(0.18, now);
            gain.gain.exponentialRampToValueAtTime(0.001, now + 0.3);
            osc.connect(gain);
            gain.connect(ctx.destination);
            osc.start(now);
            osc.stop(now + 0.3);
          } else if (type === 'click') {
            // Subtle click
            const osc = ctx.createOscillator();
            const gain = ctx.createGain();
            osc.type = 'sine';
            osc.frequency.setValueAtTime(800, now);
            gain.gain.setValueAtTime(0.05, now);
            gain.gain.exponentialRampToValueAtTime(0.001, now + 0.05);
            osc.connect(gain);
            gain.connect(ctx.destination);
            osc.start(now);
            osc.stop(now + 0.05);
          } else if (type === 'celebrate') {
            // Fanfare chords
            [523.25, 659.25, 783.99, 1046.5].forEach((freq, i) => {
              const osc = ctx.createOscillator();
              const gain = ctx.createGain();
              osc.type = 'triangle';
              osc.frequency.setValueAtTime(freq, now + i * 0.08);
              gain.gain.setValueAtTime(0.12, now + i * 0.08);
              gain.gain.exponentialRampToValueAtTime(0.001, now + i * 0.08 + 0.4);
              osc.connect(gain);
              gain.connect(ctx.destination);
              osc.start(now + i * 0.08);
              osc.stop(now + i * 0.08 + 0.4);
            });
          }
        } catch (e) {
          console.warn('Audio play error', e);
        }
      }

      // --- Text To Speech (TTS) ---
      function speakWord(text, callback) {
        if (!('speechSynthesis' in window)) {
          showToast('브라우저가 음성 읽기(TTS)를 지원하지 않습니다.', 'warning');
          if (callback) callback();
          return;
        }

        window.speechSynthesis.cancel();
        const utterance = new SpeechSynthesisUtterance(text);
        utterance.lang = 'en-US';
        utterance.rate = state.ttsSpeed || 1.0;
        utterance.pitch = 1.0;

        // Try picking best English voice
        const voices = window.speechSynthesis.getVoices();
        const enVoice = voices.find(v => v.lang.startsWith('en') && (v.name.includes('Natural') || v.name.includes('Google') || v.name.includes('Samantha')));
        if (enVoice) utterance.voice = enVoice;

        if (callback) {
          utterance.onend = () => callback();
          utterance.onerror = () => callback();
        }

        window.speechSynthesis.speak(utterance);
      }

      // Preload voices
      if ('speechSynthesis' in window) {
        window.speechSynthesis.onvoiceschanged = () => {
          window.speechSynthesis.getVoices();
        };
      }

      // --- Toast Notification ---
      function showToast(msg, type = 'info') {
        const container = document.getElementById('toast-container');
        if (!container) return;

        const toast = document.createElement('div');
        toast.className = `px-4 py-2.5 rounded-xl shadow-lg text-xs sm:text-sm font-semibold pointer-events-auto flex items-center gap-2 transform transition-all duration-300 translate-y-2 opacity-0 ${
          type === 'success' ? 'bg-emerald-600 text-white' :
          type === 'warning' ? 'bg-amber-600 text-white' :
          type === 'error' ? 'bg-rose-600 text-white' : 'bg-slate-800 text-white'
        }`;

        let icon = `<svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>`;
        if (type === 'success') icon = `<svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>`;
        
        toast.innerHTML = `${icon}<span>${msg}</span>`;
        container.appendChild(toast);

        requestAnimationFrame(() => {
          toast.classList.remove('translate-y-2', 'opacity-0');
        });

        setTimeout(() => {
          toast.classList.add('opacity-0', 'translate-y-2');
          setTimeout(() => toast.remove(), 300);
        }, 2400);
      }

      // --- Filtering ---
      function getFilteredWords() {
        let list = allWords;

        // Unit filter
        if (state.selectedUnit !== 'all') {
          const uId = parseInt(state.selectedUnit, 10);
          list = list.filter(w => w.unitId === uId);
        }

        // Query filter
        if (state.searchQuery) {
          const q = state.searchQuery.toLowerCase().trim();
          list = list.filter(w => w.word.toLowerCase().includes(q) || w.meaning.toLowerCase().includes(q));
        }

        return list;
      }

      // --- DOM Elements ---
      const listContainer = document.getElementById('word-cards-container');
      const tableBody = document.getElementById('word-table-body');
      const emptySearchState = document.getElementById('empty-search-state');
      const visibleWordsCount = document.getElementById('visible-words-count');
      const listTabCount = document.getElementById('list-tab-count');
      const headerMasteredCount = document.getElementById('header-mastered-count');
      const headerStarredCount = document.getElementById('header-starred-count');
      const notesBadgeCount = document.getElementById('notes-badge-count');

      // --- Header Updates ---
      function updateHeaderStats() {
        headerMasteredCount.textContent = state.masteredIds.size;
        headerStarredCount.textContent = state.starredIds.size;
        notesBadgeCount.textContent = state.mistakeIds.size + state.starredIds.size;

        document.getElementById('notes-mistakes-count').textContent = state.mistakeIds.size;
        document.getElementById('notes-starred-count').textContent = state.starredIds.size;
      }

      // --- Render Tab 1: Word List ---
      function renderWordList() {
        const words = getFilteredWords();
        visibleWordsCount.textContent = words.length;
        listTabCount.textContent = words.length;

        if (words.length === 0) {
          listContainer.innerHTML = '';
          tableBody.innerHTML = '';
          emptySearchState.classList.remove('hidden');
          return;
        }
        emptySearchState.classList.add('hidden');

        // Render Card View
        listContainer.innerHTML = words.map(w => {
          const isMastered = state.masteredIds.has(w.id);
          const isStarred = state.starredIds.has(w.id);

          return `
            <div class="word-card bg-white rounded-2xl p-4 border ${isMastered ? 'border-emerald-200 bg-emerald-50/20' : 'border-slate-200'} shadow-sm hover:shadow-md transition flex flex-col justify-between gap-3 group relative" data-id="${w.id}">
              
              <!-- Card Header: Unit & Actions -->
              <div class="flex items-center justify-between">
                <span class="text-[11px] font-bold px-2 py-0.5 rounded-md ${
                  w.unitId === 1 ? 'bg-blue-50 text-blue-600' :
                  w.unitId === 2 ? 'bg-purple-50 text-purple-600' :
                  w.unitId === 3 ? 'bg-emerald-50 text-emerald-600' :
                  w.unitId === 4 ? 'bg-amber-50 text-amber-600' : 'bg-teal-50 text-teal-600'
                }">
                  Unit ${w.unitId} • ${w.page}
                </span>

                <div class="flex items-center gap-1">
                  <!-- Speak Button -->
                  <button class="btn-card-speak p-1.5 text-slate-400 hover:text-indigo-600 rounded-lg hover:bg-slate-100 transition" data-word="${encodeURIComponent(w.word)}" title="발음 듣기">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z"></path>
                    </svg>
                  </button>

                  <!-- Star Button -->
                  <button class="btn-card-star p-1.5 text-slate-300 hover:text-amber-500 rounded-lg hover:bg-slate-100 transition ${isStarred ? 'text-amber-400 fill-amber-400' : ''}" data-id="${w.id}" title="북마크">
                    <svg class="w-4 h-4 ${isStarred ? 'fill-amber-400 text-amber-400' : ''}" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"></path>
                    </svg>
                  </button>

                  <!-- Master Check Button -->
                  <button class="btn-card-master p-1.5 rounded-lg hover:bg-slate-100 transition ${isMastered ? 'text-emerald-600 bg-emerald-50' : 'text-slate-300 hover:text-emerald-500'}" data-id="${w.id}" title="${isMastered ? '암기 완료됨' : '암기 완료로 표시'}">
                    <svg class="w-4 h-4" fill="${isMastered ? 'currentColor' : 'none'}" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                  </button>
                </div>
              </div>

              <!-- Main Content: Word & Meaning -->
              <div class="my-1">
                <div class="eng-word-wrapper flex items-baseline justify-between mb-1">
                  <h3 class="eng-text text-lg font-bold font-eng text-slate-900 tracking-tight cursor-pointer hover:text-indigo-600 transition select-text ${state.hideEnglish ? 'filter blur-[5px] hover:blur-none transition-all duration-300' : ''}" title="발음 듣기">${w.word}</h3>
                </div>
                
                <p class="kor-text text-sm font-semibold text-slate-700 cursor-pointer select-text ${state.hideKorean ? 'filter blur-[5px] hover:blur-none transition-all duration-300' : ''}">${w.meaning}</p>
                
                ${w.example ? `
                  <p class="text-xs text-slate-400 font-eng mt-2 pt-2 border-t border-slate-100 italic line-clamp-2" title="${w.example}">
                    "${w.example}"
                  </p>
                ` : ''}
              </div>

            </div>
          `;
        }).join('');

        // Render Table View
        tableBody.innerHTML = words.map(w => {
          const isMastered = state.masteredIds.has(w.id);
          const isStarred = state.starredIds.has(w.id);

          return `
            <tr class="hover:bg-slate-50/80 transition" data-id="${w.id}">
              <td class="py-3 px-4 text-center">
                <button class="btn-card-master p-1 rounded-md ${isMastered ? 'text-emerald-600' : 'text-slate-300 hover:text-emerald-500'}" data-id="${w.id}">
                  <svg class="w-5 h-5" fill="${isMastered ? 'currentColor' : 'none'}" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                  </svg>
                </button>
              </td>
              <td class="py-3 px-4 text-center">
                <button class="btn-card-star p-1 text-slate-300 hover:text-amber-500 ${isStarred ? 'text-amber-400 fill-amber-400' : ''}" data-id="${w.id}">
                  <svg class="w-4 h-4 ${isStarred ? 'fill-amber-400 text-amber-400' : ''}" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"></path>
                  </svg>
                </button>
              </td>
              <td class="py-3 px-4 font-bold font-eng text-slate-900 ${state.hideEnglish ? 'filter blur-[5px] hover:blur-none transition-all' : ''}">
                ${w.word}
              </td>
              <td class="py-3 px-4 text-center">
                <button class="btn-card-speak p-1 text-slate-400 hover:text-indigo-600 rounded-md hover:bg-slate-100 transition" data-word="${encodeURIComponent(w.word)}">
                  <svg class="w-4 h-4 inline" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z"></path>
                  </svg>
                </button>
              </td>
              <td class="py-3 px-4 text-slate-700 font-medium ${state.hideKorean ? 'filter blur-[5px] hover:blur-none transition-all' : ''}">
                ${w.meaning}
              </td>
              <td class="py-3 px-4 text-center text-xs text-slate-500">
                Unit ${w.unitId} (${w.page})
              </td>
              <td class="py-3 px-4 text-xs text-slate-400 italic hidden md:table-cell font-eng">
                ${w.example || '-'}
              </td>
            </tr>
          `;
        }).join('');

        attachWordListListeners();
      }

      function attachWordListListeners() {
        // Speak buttons
        document.querySelectorAll('.btn-card-speak').forEach(btn => {
          btn.onclick = (e) => {
            e.stopPropagation();
            const word = decodeURIComponent(btn.getAttribute('data-word'));
            speakWord(word);
            playSound('click');
          };
        });

        // Star buttons
        document.querySelectorAll('.btn-card-star').forEach(btn => {
          btn.onclick = (e) => {
            e.stopPropagation();
            const id = btn.getAttribute('data-id');
            if (state.starredIds.has(id)) {
              state.starredIds.delete(id);
              showToast('북마크가 해제되었습니다.');
            } else {
              state.starredIds.add(id);
              playSound('click');
              showToast('북마크에 추가되었습니다.', 'success');
            }
            persistState();
            renderWordList();
          };
        });

        // Master buttons
        document.querySelectorAll('.btn-card-master').forEach(btn => {
          btn.onclick = (e) => {
            e.stopPropagation();
            const id = btn.getAttribute('data-id');
            if (state.masteredIds.has(id)) {
              state.masteredIds.delete(id);
              showToast('암기 완료 표시가 해제되었습니다.');
            } else {
              state.masteredIds.add(id);
              playSound('correct');
              showToast('🎉 암기 완료!', 'success');
            }
            persistState();
            renderWordList();
          };
        });

        // Clicking English text directly speaks it
        document.querySelectorAll('.eng-text').forEach(el => {
          el.onclick = () => {
            speakWord(el.textContent.trim());
            playSound('click');
          };
        });
      }

      // --- Autoplay All Words in List ---
      function toggleAutoplayList() {
        const btn = document.getElementById('btn-autoplay-all');
        const label = document.getElementById('autoplay-label');

        if (state.listAutoplayTimer) {
          clearInterval(state.listAutoplayTimer);
          state.listAutoplayTimer = null;
          state.listAutoplayIndex = -1;
          btn.classList.remove('bg-indigo-600', 'text-white');
          btn.classList.add('bg-indigo-50', 'text-indigo-700');
          label.textContent = '전체 발음 연속재생';
          window.speechSynthesis.cancel();
          showToast('연속 재생이 중지되었습니다.');
          return;
        }

        const words = getFilteredWords();
        if (words.length === 0) {
          showToast('재생할 단어가 없습니다.', 'warning');
          return;
        }

        btn.classList.remove('bg-indigo-50', 'text-indigo-700');
        btn.classList.add('bg-indigo-600', 'text-white');
        label.textContent = '재생 정지 (정지하려면 클릭)';
        showToast('연속 발음 재생을 시작합니다.', 'info');

        state.listAutoplayIndex = 0;
        playNextListItem();
      }

      function playNextListItem() {
        const words = getFilteredWords();
        if (state.listAutoplayIndex < 0 || state.listAutoplayIndex >= words.length) {
          toggleAutoplayList();
          return;
        }

        const currentWord = words[state.listAutoplayIndex];
        // Highlight active card
        document.querySelectorAll('.word-card').forEach(c => c.classList.remove('ring-2', 'ring-indigo-500'));
        const activeCard = document.querySelector(`.word-card[data-id="${currentWord.id}"]`);
        if (activeCard) {
          activeCard.classList.add('ring-2', 'ring-indigo-500');
          activeCard.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }

        speakWord(currentWord.word, () => {
          state.listAutoplayTimer = setTimeout(() => {
            state.listAutoplayIndex++;
            playNextListItem();
          }, 1200);
        });
      }

      // --- TAB 2: Flashcards Logic ---
      const fcInner = document.getElementById('flashcard-inner');
      const fcFrontMain = document.getElementById('fc-front-main');
      const fcFrontSub = document.getElementById('fc-front-sub');
      const fcBackMeaning = document.getElementById('fc-back-meaning');
      const fcBackWord = document.getElementById('fc-back-word');
      const fcBackExample = document.getElementById('fc-back-example');
      const fcCounter = document.getElementById('fc-counter');
      const fcProgressBar = document.getElementById('fc-progress-bar');
      const fcUnitTag = document.getElementById('fc-unit-tag');
      const fcPageTag = document.getElementById('fc-page-tag');
      const fcFrontStarIcon = document.getElementById('fc-front-star-icon');

      let flashcardList = [];

      function initFlashcards() {
        flashcardList = [...getFilteredWords()];
        if (flashcardList.length === 0) flashcardList = [...allWords];
        state.fcIndex = 0;
        state.fcFlipped = false;
        renderCurrentFlashcard();
      }

      function renderCurrentFlashcard() {
        if (flashcardList.length === 0) return;
        if (state.fcIndex >= flashcardList.length) state.fcIndex = 0;
        if (state.fcIndex < 0) state.fcIndex = flashcardList.length - 1;

        const item = flashcardList[state.fcIndex];
        state.fcFlipped = false;
        fcInner.classList.remove('rotate-y-180');

        fcUnitTag.textContent = `Unit ${item.unitId}`;
        fcPageTag.textContent = item.page;
        fcCounter.textContent = `${state.fcIndex + 1} / ${flashcardList.length}`;
        fcProgressBar.style.width = `${((state.fcIndex + 1) / flashcardList.length) * 100}%`;

        const isStarred = state.starredIds.has(item.id);
        if (isStarred) {
          fcFrontStarIcon.classList.add('text-amber-400', 'fill-amber-400');
          fcFrontStarIcon.classList.remove('text-slate-300');
        } else {
          fcFrontStarIcon.classList.remove('text-amber-400', 'fill-amber-400');
          fcFrontStarIcon.classList.add('text-slate-300');
        }

        if (state.fcMode === 'eng2kor') {
          fcFrontMain.textContent = item.word;
          fcFrontSub.textContent = '스페이스바 또는 카드를 탭하여 뜻 확인';
          fcBackMeaning.textContent = item.meaning;
          fcBackWord.textContent = item.word;
        } else {
          fcFrontMain.textContent = item.meaning;
          fcFrontSub.textContent = '스페이스바 또는 카드를 탭하여 영단어 확인';
          fcBackMeaning.textContent = item.word;
          fcBackWord.textContent = item.meaning;
        }

        fcBackExample.textContent = item.example || 'No example sentence available.';
      }

      function flipFlashcard() {
        state.fcFlipped = !state.fcFlipped;
        if (state.fcFlipped) {
          fcInner.classList.add('rotate-y-180');
          playSound('click');
        } else {
          fcInner.classList.remove('rotate-y-180');
          playSound('click');
        }
      }

      function nextFlashcard() {
        state.fcIndex++;
        playSound('click');
        renderCurrentFlashcard();
      }

      function prevFlashcard() {
        state.fcIndex--;
        playSound('click');
        renderCurrentFlashcard();
      }

      function toggleFlashcardSlideshow() {
        const btn = document.getElementById('fc-autoplay-slideshow-btn');
        const label = document.getElementById('fc-slideshow-label');

        if (state.fcAutoplayTimer) {
          clearInterval(state.fcAutoplayTimer);
          state.fcAutoplayTimer = null;
          btn.classList.remove('bg-indigo-600', 'text-white');
          btn.classList.add('bg-slate-100', 'text-slate-700');
          label.textContent = '자동 넘김';
          showToast('슬라이드쇼가 중지되었습니다.');
          return;
        }

        btn.classList.remove('bg-slate-100', 'text-slate-700');
        btn.classList.add('bg-indigo-600', 'text-white');
        label.textContent = '자동 정지';
        showToast('플래시카드 자동 넘김 시작 (발음 후 다음 단어)', 'info');

        function runSlideshowStep() {
          const item = flashcardList[state.fcIndex];
          speakWord(item.word, () => {
            state.fcAutoplayTimer = setTimeout(() => {
              flipFlashcard();
              state.fcAutoplayTimer = setTimeout(() => {
                nextFlashcard();
                runSlideshowStep();
              }, 1800);
            }, 1200);
          });
        }

        runSlideshowStep();
      }

      // --- TAB 3: 4지선다 퀴즈 (Multiple Choice Quiz) ---
      const quizSetupCard = document.getElementById('quiz-setup-card');
      const quizActiveCard = document.getElementById('quiz-active-card');
      const quizResultCard = document.getElementById('quiz-result-card');
      const quizQuestionText = document.getElementById('quiz-question-text');
      const quizInstruction = document.getElementById('quiz-instruction');
      const quizCurrentNum = document.getElementById('quiz-current-num');
      const quizUnitLabel = document.getElementById('quiz-unit-label');
      const quizStreakBadge = document.getElementById('quiz-streak-badge');
      const quizStreakCount = document.getElementById('quiz-streak-count');
      const quizScoreVal = document.getElementById('quiz-score-val');
      const quizProgressBar = document.getElementById('quiz-progress-bar');
      const quizOptionsContainer = document.getElementById('quiz-options-container');
      const quizFeedbackBox = document.getElementById('quiz-feedback-box');
      const quizNextBtn = document.getElementById('quiz-next-btn');

      function startQuiz(customItems = null) {
        let pool = customItems || getFilteredWords();
        if (pool.length < 4) pool = allWords;

        // Shuffle pool
        pool = [...pool].sort(() => Math.random() - 0.5);

        let count = state.quizCount === 'all' ? pool.length : parseInt(state.quizCount, 10);
        if (isNaN(count) || count > pool.length) count = pool.length;

        state.quizItems = pool.slice(0, count);
        state.quizCurrentIdx = 0;
        state.quizScore = 0;
        state.quizStreak = 0;
        state.quizMaxStreak = 0;
        state.quizMissedIds = [];
        state.quizActive = true;

        quizSetupCard.classList.add('hidden');
        quizResultCard.classList.add('hidden');
        quizActiveCard.classList.remove('hidden');

        renderQuizQuestion();
      }

      function renderQuizQuestion() {
        state.quizAnswered = false;
        quizFeedbackBox.classList.add('hidden');
        quizNextBtn.classList.add('hidden');

        const current = state.quizItems[state.quizCurrentIdx];
        const total = state.quizItems.length;

        quizCurrentNum.textContent = `Q ${state.quizCurrentIdx + 1} / ${total}`;
        quizUnitLabel.textContent = `Unit ${current.unitId} (${current.page})`;
        quizScoreVal.textContent = state.quizScore;
        quizProgressBar.style.width = `${((state.quizCurrentIdx + 1) / total) * 100}%`;

        if (state.quizStreak >= 2) {
          quizStreakBadge.classList.remove('hidden');
          quizStreakBadge.classList.add('flex');
          quizStreakCount.textContent = state.quizStreak;
        } else {
          quizStreakBadge.classList.add('hidden');
          quizStreakBadge.classList.remove('flex');
        }

        // Set Question Prompt
        if (state.quizType === 'eng2kor') {
          quizInstruction.textContent = '다음 영단어의 알맞은 뜻을 고르세요';
          quizQuestionText.textContent = current.word;
          quizQuestionText.className = 'text-3xl sm:text-4xl font-extrabold text-slate-900 font-eng';
        } else {
          quizInstruction.textContent = '다음 한글 뜻에 해당하는 영단어를 고르세요';
          quizQuestionText.textContent = current.meaning;
          quizQuestionText.className = 'text-2xl sm:text-3xl font-extrabold text-slate-900';
        }

        // Auto speak word if eng2kor
        if (state.quizType === 'eng2kor') {
          speakWord(current.word);
        }

        // Generate 4 randomized options (1 correct + 3 distractors)
        const distractors = allWords
          .filter(w => w.id !== current.id)
          .sort(() => Math.random() - 0.5)
          .slice(0, 3);

        const options = [current, ...distractors].sort(() => Math.random() - 0.5);

        quizOptionsContainer.innerHTML = options.map((opt, i) => {
          const isCorrect = opt.id === current.id;
          const displayTxt = state.quizType === 'eng2kor' ? opt.meaning : opt.word;

          return `
            <button class="quiz-opt-btn w-full p-4 rounded-2xl border-2 border-slate-200 hover:border-indigo-400 bg-white hover:bg-indigo-50/30 text-left font-semibold text-slate-800 transition active:scale-[0.99] flex items-center justify-between group shadow-xs" data-correct="${isCorrect}" data-id="${opt.id}">
              <div class="flex items-center gap-3">
                <span class="w-7 h-7 rounded-lg bg-slate-100 group-hover:bg-indigo-100 group-hover:text-indigo-600 text-slate-500 font-bold text-xs flex items-center justify-center font-mono">${['A', 'B', 'C', 'D'][i]}</span>
                <span class="text-sm sm:text-base ${state.quizType === 'kor2eng' ? 'font-eng' : ''}">${displayTxt}</span>
              </div>
              <span class="opt-result-icon hidden"></span>
            </button>
          `;
        }).join('');

        // Attach option click handlers
        document.querySelectorAll('.quiz-opt-btn').forEach(btn => {
          btn.onclick = () => handleQuizAnswer(btn);
        });
      }

      function handleQuizAnswer(selectedBtn) {
        if (state.quizAnswered) return;
        state.quizAnswered = true;

        const isCorrect = selectedBtn.getAttribute('data-correct') === 'true';
        const current = state.quizItems[state.quizCurrentIdx];

        // Disable all buttons and show colors
        document.querySelectorAll('.quiz-opt-btn').forEach(btn => {
          btn.disabled = true;
          const correct = btn.getAttribute('data-correct') === 'true';
          const iconSpan = btn.querySelector('.opt-result-icon');
          iconSpan.classList.remove('hidden');

          if (correct) {
            btn.classList.remove('border-slate-200', 'bg-white');
            btn.classList.add('border-emerald-500', 'bg-emerald-50', 'text-emerald-900');
            iconSpan.innerHTML = `<svg class="w-5 h-5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>`;
          } else if (btn === selectedBtn) {
            btn.classList.remove('border-slate-200', 'bg-white');
            btn.classList.add('border-rose-500', 'bg-rose-50', 'text-rose-900');
            iconSpan.innerHTML = `<svg class="w-5 h-5 text-rose-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>`;
          }
        });

        const feedbackIcon = document.getElementById('feedback-icon');
        const feedbackTitle = document.getElementById('feedback-title');
        const feedbackDesc = document.getElementById('feedback-desc');
        const feedbackExample = document.getElementById('feedback-example');

        if (isCorrect) {
          playSound('correct');
          state.quizScore += 10 + (state.quizStreak * 2);
          state.quizStreak++;
          if (state.quizStreak > state.quizMaxStreak) state.quizMaxStreak = state.quizStreak;

          state.masteredIds.add(current.id);
          state.mistakeIds.delete(current.id);

          quizFeedbackBox.className = 'p-4 rounded-2xl border text-sm mb-4 transition-all bg-emerald-50 border-emerald-200 text-emerald-900';
          feedbackIcon.innerHTML = `<div class="w-6 h-6 rounded-full bg-emerald-500 text-white flex items-center justify-center font-bold text-xs">✓</div>`;
          feedbackTitle.textContent = state.quizStreak >= 3 ? `🎉 정답! (${state.quizStreak}연속 콤보 +${state.quizStreak * 2}점)` : '정답입니다!';
        } else {
          playSound('wrong');
          state.quizStreak = 0;
          state.quizMissedIds.push(current.id);
          state.mistakeIds.add(current.id);

          quizFeedbackBox.className = 'p-4 rounded-2xl border text-sm mb-4 transition-all bg-rose-50 border-rose-200 text-rose-900';
          feedbackIcon.innerHTML = `<div class="w-6 h-6 rounded-full bg-rose-500 text-white flex items-center justify-center font-bold text-xs">✕</div>`;
          feedbackTitle.textContent = '아쉽습니다. 오답입니다!';
        }

        feedbackDesc.textContent = `${current.word} : ${current.meaning}`;
        feedbackExample.textContent = current.example || 'Example context not available.';
        quizFeedbackBox.classList.remove('hidden');
        quizNextBtn.classList.remove('hidden');

        persistState();
      }

      function nextQuizQuestion() {
        state.quizCurrentIdx++;
        if (state.quizCurrentIdx >= state.quizItems.length) {
          finishQuiz();
        } else {
          renderQuizQuestion();
        }
      }

      function finishQuiz() {
        playSound('celebrate');
        quizActiveCard.classList.add('hidden');
        quizResultCard.classList.remove('hidden');

        const total = state.quizItems.length;
        const correct = total - state.quizMissedIds.length;
        const acc = Math.round((correct / total) * 100);

        document.getElementById('res-total-count').textContent = total;
        document.getElementById('res-correct-count').textContent = correct;
        document.getElementById('res-accuracy-rate').textContent = `${acc}%`;
        document.getElementById('res-missed-count').textContent = state.quizMissedIds.length;

        const missedListEl = document.getElementById('res-missed-list');
        const missedSection = document.getElementById('res-missed-section');
        const retryMissedBtn = document.getElementById('res-retry-missed-btn');

        if (state.quizMissedIds.length === 0) {
          missedSection.classList.add('hidden');
          retryMissedBtn.classList.add('hidden');
        } else {
          missedSection.classList.remove('hidden');
          retryMissedBtn.classList.remove('hidden');
          missedListEl.innerHTML = state.quizMissedIds.map(id => {
            const w = allWords.find(item => item.id === id);
            return `
              <div class="p-2.5 rounded-xl bg-slate-50 border border-slate-200 flex items-center justify-between text-xs">
                <div>
                  <span class="font-bold font-eng text-slate-800">${w.word}</span>
                  <span class="text-slate-500 ml-2">${w.meaning}</span>
                </div>
                <button class="p-1 text-slate-400 hover:text-indigo-600" onclick="window.speakWord('${encodeURIComponent(w.word)}')">
                  🔊
                </button>
              </div>
            `;
          }).join('');
        }
      }

      // --- TAB 4: 빈칸 스펠링 (Cloze & Spelling) ---
      const clozeCounterBadge = document.getElementById('cloze-counter-badge');
      const clozeUnitTag = document.getElementById('cloze-unit-tag');
      const clozeMeaningText = document.getElementById('cloze-meaning-text');
      const clozeExampleBefore = document.getElementById('cloze-example-before');
      const clozeExampleTarget = document.getElementById('cloze-example-target');
      const clozeExampleAfter = document.getElementById('cloze-example-after');
      const clozeLetterBoxes = document.getElementById('cloze-letter-boxes');
      const clozeInput = document.getElementById('cloze-input');
      const clozeFeedback = document.getElementById('cloze-feedback');

      function initCloze() {
        state.clozeItems = [...getFilteredWords()];
        if (state.clozeItems.length === 0) state.clozeItems = [...allWords];
        state.clozeIndex = 0;
        state.clozeHintLevel = 0;
        renderClozeItem();
      }

      function renderClozeItem() {
        if (state.clozeItems.length === 0) return;
        if (state.clozeIndex >= state.clozeItems.length) state.clozeIndex = 0;
        if (state.clozeIndex < 0) state.clozeIndex = state.clozeItems.length - 1;

        const current = state.clozeItems[state.clozeIndex];
        state.clozeHintLevel = 0;
        clozeInput.value = '';
        clozeFeedback.classList.add('hidden');

        clozeCounterBadge.textContent = `문제 ${state.clozeIndex + 1} / ${state.clozeItems.length}`;
        clozeUnitTag.textContent = `Unit ${current.unitId} (${current.page})`;
        clozeMeaningText.textContent = current.meaning;

        // Break example sentence around word
        const targetWord = current.word;
        const ex = current.example || '';
        const regex = new RegExp(`\\b${targetWord}\\b`, 'i');
        const match = ex.match(regex);

        if (match) {
          const idx = match.index;
          clozeExampleBefore.textContent = ex.slice(0, idx);
          clozeExampleTarget.textContent = '_ '.repeat(targetWord.length).trim();
          clozeExampleAfter.textContent = ex.slice(idx + targetWord.length);
        } else {
          clozeExampleBefore.textContent = 'Context: ';
          clozeExampleTarget.textContent = targetWord.replace(/[a-zA-Z]/g, '_ ');
          clozeExampleAfter.textContent = '';
        }

        // Render letter length blocks
        renderLetterBoxes(targetWord, state.clozeHintLevel);
        clozeInput.focus();
      }

      function renderLetterBoxes(word, hintLevel) {
        clozeLetterBoxes.innerHTML = word.split('').map((ch, idx) => {
          if (ch === ' ' || ch === '-' || ch === "'") {
            return `<span class="w-4 text-center font-bold text-slate-400">${ch}</span>`;
          }
          let revealed = false;
          if (hintLevel >= 1 && idx === 0) revealed = true;
          if (hintLevel >= 2 && idx < Math.ceil(word.length / 2)) revealed = true;

          return `
            <div class="w-8 h-9 sm:w-9 sm:h-10 rounded-xl border-2 ${revealed ? 'border-purple-500 bg-purple-50 text-purple-700 font-bold' : 'border-slate-200 bg-slate-50 text-slate-400'} flex items-center justify-center font-eng font-bold text-base sm:text-lg shadow-2xs">
              ${revealed ? ch : '_'}
            </div>
          `;
        }).join('');
      }

      function checkClozeAnswer() {
        const current = state.clozeItems[state.clozeIndex];
        const userAns = clozeInput.value.trim().toLowerCase();
        const targetAns = current.word.toLowerCase();

        clozeFeedback.classList.remove('hidden');

        if (userAns === targetAns) {
          playSound('correct');
          clozeFeedback.className = 'p-3.5 rounded-xl text-xs sm:text-sm font-semibold mb-4 bg-emerald-50 border border-emerald-200 text-emerald-800 flex items-center gap-2';
          clozeFeedback.innerHTML = `
            <svg class="w-5 h-5 text-emerald-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
            <span>정답입니다! <strong>${current.word}</strong> (${current.meaning})</span>
          `;
          speakWord(current.word);
          state.masteredIds.add(current.id);
          state.mistakeIds.delete(current.id);
          persistState();

          setTimeout(() => {
            state.clozeIndex++;
            renderClozeItem();
          }, 1500);
        } else {
          playSound('wrong');
          clozeFeedback.className = 'p-3.5 rounded-xl text-xs sm:text-sm font-semibold mb-4 bg-rose-50 border border-rose-200 text-rose-800 flex items-center gap-2';
          clozeFeedback.innerHTML = `
            <svg class="w-5 h-5 text-rose-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
            <span>틀렸습니다. 다시 시도하거나 힌트를 확인하세요!</span>
          `;
          state.mistakeIds.add(current.id);
          persistState();
        }
      }

      // --- TAB 5: 오답노트 & 북마크 (Mistakes & Bookmarks) ---
      const notesItemsGrid = document.getElementById('notes-items-grid');
      const notesEmptyState = document.getElementById('notes-empty-state');
      const notesEmptyTitle = document.getElementById('notes-empty-title');
      const notesEmptyDesc = document.getElementById('notes-empty-desc');

      function renderNotesTab() {
        const isMistakes = state.notesSubtab === 'mistakes';
        const targetIds = isMistakes ? state.mistakeIds : state.starredIds;
        const words = allWords.filter(w => targetIds.has(w.id));

        if (words.length === 0) {
          notesItemsGrid.innerHTML = '';
          notesEmptyState.classList.remove('hidden');
          notesEmptyTitle.textContent = isMistakes ? '오답 단어가 없습니다' : '북마크한 단어가 없습니다';
          notesEmptyDesc.textContent = isMistakes
            ? '퀴즈나 스펠링 빈칸 챌린지에서 틀린 단어가 자동으로 이곳에 모입니다.'
            : '단어장이나 플래시카드에서 별(⭐) 아이콘을 눌러 나만의 단어를 모아보세요.';
          return;
        }
        notesEmptyState.classList.add('hidden');

        notesItemsGrid.innerHTML = words.map(w => `
          <div class="bg-white rounded-2xl p-4 border border-slate-200 shadow-sm hover:shadow-md transition flex flex-col justify-between gap-3">
            <div class="flex items-center justify-between">
              <span class="text-[11px] font-bold px-2 py-0.5 rounded-md bg-slate-100 text-slate-600">
                Unit ${w.unitId} • ${w.page}
              </span>
              <div class="flex items-center gap-1">
                <button class="btn-notes-speak p-1.5 text-slate-400 hover:text-indigo-600 rounded-lg hover:bg-slate-100" data-word="${encodeURIComponent(w.word)}" title="발음 듣기">
                  🔊
                </button>
                <button class="btn-notes-remove p-1.5 text-slate-300 hover:text-rose-500 rounded-lg hover:bg-slate-100" data-id="${w.id}" title="이 목록에서 제거">
                  ✕
                </button>
              </div>
            </div>

            <div>
              <h4 class="text-lg font-bold font-eng text-slate-900">${w.word}</h4>
              <p class="text-sm font-semibold text-slate-700 mt-0.5">${w.meaning}</p>
              ${w.example ? `<p class="text-xs text-slate-400 font-eng italic mt-2 pt-2 border-t border-slate-100 line-clamp-2">${w.example}</p>` : ''}
            </div>

            <div class="pt-2 flex justify-end">
              <button class="btn-notes-master text-xs font-semibold px-2.5 py-1 rounded-lg bg-emerald-50 text-emerald-700 hover:bg-emerald-100 transition" data-id="${w.id}">
                완벽 암기 완료 ✓
              </button>
            </div>
          </div>
        `).join('');

        // Attach listeners
        document.querySelectorAll('.btn-notes-speak').forEach(btn => {
          btn.onclick = () => speakWord(decodeURIComponent(btn.getAttribute('data-word')));
        });

        document.querySelectorAll('.btn-notes-remove').forEach(btn => {
          btn.onclick = () => {
            const id = btn.getAttribute('data-id');
            if (isMistakes) state.mistakeIds.delete(id);
            else state.starredIds.delete(id);
            persistState();
            renderNotesTab();
            showToast('목록에서 제거되었습니다.');
          };
        });

        document.querySelectorAll('.btn-notes-master').forEach(btn => {
          btn.onclick = () => {
            const id = btn.getAttribute('data-id');
            state.masteredIds.add(id);
            if (isMistakes) state.mistakeIds.delete(id);
            persistState();
            renderNotesTab();
            playSound('correct');
            showToast('암기 완료 처리되었습니다! 🎉', 'success');
          };
        });
      }

      // --- Tab Switching ---
      function switchTab(tabName) {
        state.activeTab = tabName;
        document.querySelectorAll('.tab-btn').forEach(btn => {
          if (btn.getAttribute('data-tab') === tabName) {
            btn.classList.add('bg-indigo-600', 'text-white', 'shadow-sm', 'shadow-indigo-200');
            btn.classList.remove('text-slate-600', 'hover:bg-indigo-50');
          } else {
            btn.classList.remove('bg-indigo-600', 'text-white', 'shadow-sm', 'shadow-indigo-200');
            btn.classList.add('text-slate-600', 'hover:bg-indigo-50');
          }
        });

        document.querySelectorAll('.tab-view').forEach(v => v.classList.add('hidden'));

        if (tabName === 'list') {
          document.getElementById('view-list').classList.remove('hidden');
          renderWordList();
        } else if (tabName === 'flashcard') {
          document.getElementById('view-flashcard').classList.remove('hidden');
          initFlashcards();
        } else if (tabName === 'quiz') {
          document.getElementById('view-quiz').classList.remove('hidden');
          if (!state.quizActive) {
            quizSetupCard.classList.remove('hidden');
            quizActiveCard.classList.add('hidden');
            quizResultCard.classList.add('hidden');
          }
        } else if (tabName === 'cloze') {
          document.getElementById('view-cloze').classList.remove('hidden');
          initCloze();
        } else if (tabName === 'notes') {
          document.getElementById('view-notes').classList.remove('hidden');
          renderNotesTab();
        }

        playSound('click');
      }

      // --- Event Listeners Setup ---
      function setupEvents() {
        // Navigation Tabs
        document.querySelectorAll('.tab-btn').forEach(btn => {
          btn.onclick = () => switchTab(btn.getAttribute('data-tab'));
        });

        // Brand logo clicks return to list
        document.getElementById('brand-logo-btn').onclick = () => switchTab('list');

        // Unit Filter Buttons
        document.querySelectorAll('.unit-filter-btn').forEach(btn => {
          btn.onclick = () => {
            state.selectedUnit = btn.getAttribute('data-unit');
            document.querySelectorAll('.unit-filter-btn').forEach(b => {
              b.classList.remove('bg-indigo-600', 'text-white');
              b.classList.add('bg-slate-100', 'text-slate-600');
            });
            btn.classList.add('bg-indigo-600', 'text-white');
            btn.classList.remove('bg-slate-100', 'text-slate-600');

            playSound('click');
            if (state.activeTab === 'list') renderWordList();
            else if (state.activeTab === 'flashcard') initFlashcards();
            else if (state.activeTab === 'cloze') initCloze();

            // Update quiz scope indicator
            const scopeLabel = state.selectedUnit === 'all' ? '전체 단어 (148단어)' : `Unit ${state.selectedUnit} 단어`;
            document.getElementById('quiz-scope-text').textContent = scopeLabel;
          };
        });

        // Search Input
        const searchInput = document.getElementById('global-search-input');
        const clearSearchBtn = document.getElementById('clear-search-btn');

        searchInput.oninput = (e) => {
          state.searchQuery = e.target.value;
          if (state.searchQuery) clearSearchBtn.classList.remove('hidden');
          else clearSearchBtn.classList.add('hidden');
          renderWordList();
        };

        clearSearchBtn.onclick = () => {
          searchInput.value = '';
          state.searchQuery = '';
          clearSearchBtn.classList.add('hidden');
          renderWordList();
        };

        // Sound Toggle
        const soundBtn = document.getElementById('sound-toggle-btn');
        const soundOnIcon = document.getElementById('sound-on-icon');
        const soundOffIcon = document.getElementById('sound-off-icon');

        soundBtn.onclick = () => {
          state.soundEnabled = !state.soundEnabled;
          if (state.soundEnabled) {
            soundOnIcon.classList.remove('hidden');
            soundOffIcon.classList.add('hidden');
            playSound('correct');
            showToast('효과음이 켜졌습니다.');
          } else {
            soundOnIcon.classList.add('hidden');
            soundOffIcon.classList.remove('hidden');
            showToast('효과음이 꺼졌습니다.');
          }
          persistState();
        };

        // TTS Speed
        const speedSelect = document.getElementById('tts-speed-select');
        speedSelect.value = state.ttsSpeed.toString();
        speedSelect.onchange = (e) => {
          state.ttsSpeed = parseFloat(e.target.value);
          persistState();
          showToast(`발음 속도가 ${state.ttsSpeed}x로 설정되었습니다.`);
          speakWord('Audio speed updated');
        };

        // Hide English / Korean Masking Toggles
        const hideEngBtn = document.getElementById('toggle-hide-eng');
        const hideKorBtn = document.getElementById('toggle-hide-kor');

        hideEngBtn.onclick = () => {
          state.hideEnglish = !state.hideEnglish;
          hideEngBtn.classList.toggle('bg-indigo-50', state.hideEnglish);
          hideEngBtn.classList.toggle('text-indigo-700', state.hideEnglish);
          hideEngBtn.classList.toggle('border-indigo-300', state.hideEnglish);
          document.getElementById('hide-eng-label').textContent = state.hideEnglish ? '영어 보이기' : '영단어 가리기';
          renderWordList();
        };

        hideKorBtn.onclick = () => {
          state.hideKorean = !state.hideKorean;
          hideKorBtn.classList.toggle('bg-indigo-50', state.hideKorean);
          hideKorBtn.classList.toggle('text-indigo-700', state.hideKorean);
          hideKorBtn.classList.toggle('border-indigo-300', state.hideKorean);
          document.getElementById('hide-kor-label').textContent = state.hideKorean ? '한글 보이기' : '한글뜻 가리기';
          renderWordList();
        };

        // Layout Cards / Table Toggle
        const layoutCardsBtn = document.getElementById('layout-cards-btn');
        const layoutTableBtn = document.getElementById('layout-table-btn');
        const cardsContainer = document.getElementById('word-cards-container');
        const tableContainer = document.getElementById('word-table-container');

        layoutCardsBtn.onclick = () => {
          state.layoutMode = 'cards';
          layoutCardsBtn.classList.add('bg-white', 'text-indigo-600', 'shadow-xs');
          layoutCardsBtn.classList.remove('text-slate-400');
          layoutTableBtn.classList.remove('bg-white', 'text-indigo-600', 'shadow-xs');
          layoutTableBtn.classList.add('text-slate-400');
          cardsContainer.classList.remove('hidden');
          tableContainer.classList.add('hidden');
        };

        layoutTableBtn.onclick = () => {
          state.layoutMode = 'table';
          layoutTableBtn.classList.add('bg-white', 'text-indigo-600', 'shadow-xs');
          layoutTableBtn.classList.remove('text-slate-400');
          layoutCardsBtn.classList.remove('bg-white', 'text-indigo-600', 'shadow-xs');
          layoutCardsBtn.classList.add('text-slate-400');
          cardsContainer.classList.add('hidden');
          tableContainer.classList.remove('hidden');
        };

        // Word List Autoplay
        document.getElementById('btn-autoplay-all').onclick = toggleAutoplayList;

        // Flashcard Interactions
        document.getElementById('flashcard-element').onclick = flipFlashcard;
        document.getElementById('fc-flip-btn').onclick = (e) => { e.stopPropagation(); flipFlashcard(); };
        document.getElementById('fc-next-btn').onclick = nextFlashcard;
        document.getElementById('fc-prev-btn').onclick = prevFlashcard;
        document.getElementById('fc-autoplay-slideshow-btn').onclick = toggleFlashcardSlideshow;

        document.getElementById('fc-pronounce-btn').onclick = (e) => {
          e.stopPropagation();
          const item = flashcardList[state.fcIndex];
          speakWord(item.word);
        };

        document.getElementById('fc-back-pronounce-btn').onclick = (e) => {
          e.stopPropagation();
          const item = flashcardList[state.fcIndex];
          speakWord(item.word);
        };

        document.getElementById('fc-front-star-btn').onclick = (e) => {
          e.stopPropagation();
          const item = flashcardList[state.fcIndex];
          if (state.starredIds.has(item.id)) state.starredIds.delete(item.id);
          else state.starredIds.add(item.id);
          persistState();
          renderCurrentFlashcard();
        };

        document.getElementById('fc-mark-master-btn').onclick = () => {
          const item = flashcardList[state.fcIndex];
          state.masteredIds.add(item.id);
          state.mistakeIds.delete(item.id);
          persistState();
          playSound('correct');
          showToast('다 외운 단어로 표시했습니다! 🎉', 'success');
          nextFlashcard();
        };

        document.getElementById('fc-mark-review-btn').onclick = () => {
          const item = flashcardList[state.fcIndex];
          state.mistakeIds.add(item.id);
          persistState();
          playSound('wrong');
          showToast('오답노트에 기록했습니다.', 'warning');
          nextFlashcard();
        };

        document.getElementById('fc-flip-mode-btn').onclick = () => {
          state.fcMode = state.fcMode === 'eng2kor' ? 'kor2eng' : 'eng2kor';
          document.getElementById('fc-mode-text').textContent = state.fcMode === 'eng2kor' ? '영단어' : '한글뜻';
          playSound('click');
          renderCurrentFlashcard();
        };

        document.getElementById('fc-shuffle-btn').onclick = () => {
          flashcardList.sort(() => Math.random() - 0.5);
          state.fcIndex = 0;
          playSound('click');
          showToast('플래시카드 순서를 섞었습니다.');
          renderCurrentFlashcard();
        };

        // Header Starred Button -> Jump to Notes Starred Tab
        document.getElementById('header-starred-btn').onclick = () => {
          state.notesSubtab = 'starred';
          switchTab('notes');
        };

        // Quiz Setup Buttons
        document.querySelectorAll('.quiz-type-btn').forEach(btn => {
          btn.onclick = () => {
            state.quizType = btn.getAttribute('data-type');
            document.querySelectorAll('.quiz-type-btn').forEach(b => {
              b.classList.remove('border-indigo-600', 'bg-indigo-50/50', 'text-indigo-900');
              b.classList.add('border-slate-200', 'bg-slate-50', 'text-slate-700');
            });
            btn.classList.add('border-indigo-600', 'bg-indigo-50/50', 'text-indigo-900');
            btn.classList.remove('border-slate-200', 'bg-slate-50', 'text-slate-700');
          };
        });

        document.querySelectorAll('.quiz-count-btn').forEach(btn => {
          btn.onclick = () => {
            state.quizCount = btn.getAttribute('data-count');
            document.querySelectorAll('.quiz-count-btn').forEach(b => {
              b.classList.remove('border-2', 'border-indigo-600', 'bg-indigo-50/50', 'text-indigo-900', 'font-bold');
              b.classList.add('border', 'border-slate-200', 'text-slate-700');
            });
            btn.classList.add('border-2', 'border-indigo-600', 'bg-indigo-50/50', 'text-indigo-900', 'font-bold');
            btn.classList.remove('border', 'border-slate-200');
          };
        });

        document.getElementById('start-quiz-btn').onclick = () => startQuiz();
        document.getElementById('quiz-next-btn').onclick = nextQuizQuestion;
        document.getElementById('quiz-quit-btn').onclick = () => {
          state.quizActive = false;
          quizActiveCard.classList.add('hidden');
          quizSetupCard.classList.remove('hidden');
        };
        document.getElementById('quiz-speak-btn').onclick = () => {
          const current = state.quizItems[state.quizCurrentIdx];
          speakWord(current.word);
        };
        document.getElementById('res-restart-btn').onclick = () => {
          state.quizActive = false;
          quizResultCard.classList.add('hidden');
          quizSetupCard.classList.remove('hidden');
        };
        document.getElementById('res-retry-missed-btn').onclick = () => {
          const missedWords = allWords.filter(w => state.quizMissedIds.includes(w.id));
          startQuiz(missedWords);
        };

        // Cloze / Spelling Handlers
        document.getElementById('cloze-form').onsubmit = (e) => {
          e.preventDefault();
          checkClozeAnswer();
        };
        document.getElementById('cloze-next-btn').onclick = () => {
          state.clozeIndex++;
          renderClozeItem();
        };
        document.getElementById('cloze-prev-btn').onclick = () => {
          state.clozeIndex--;
          renderClozeItem();
        };
        document.getElementById('cloze-skip-btn').onclick = () => {
          const current = state.clozeItems[state.clozeIndex];
          clozeInput.value = current.word;
          checkClozeAnswer();
        };
        document.getElementById('cloze-speak-btn').onclick = () => {
          const current = state.clozeItems[state.clozeIndex];
          speakWord(current.word);
        };
        document.getElementById('cloze-hint-first-btn').onclick = () => {
          state.clozeHintLevel++;
          const current = state.clozeItems[state.clozeIndex];
          renderLetterBoxes(current.word, state.clozeHintLevel);
          clozeInput.focus();
        };

        // Notes Subtab Switchers
        const notesTabMistakes = document.getElementById('notes-tab-mistakes');
        const notesTabStarred = document.getElementById('notes-tab-starred');

        notesTabMistakes.onclick = () => {
          state.notesSubtab = 'mistakes';
          notesTabMistakes.className = 'notes-subtab-btn active px-4 py-2 rounded-xl text-xs font-bold bg-rose-50 text-rose-700 border border-rose-200 flex items-center gap-1.5 transition';
          notesTabStarred.className = 'notes-subtab-btn px-4 py-2 rounded-xl text-xs font-bold bg-slate-100 text-slate-600 hover:bg-slate-200 flex items-center gap-1.5 transition';
          renderNotesTab();
        };

        notesTabStarred.onclick = () => {
          state.notesSubtab = 'starred';
          notesTabStarred.className = 'notes-subtab-btn active px-4 py-2 rounded-xl text-xs font-bold bg-amber-50 text-amber-700 border border-amber-200 flex items-center gap-1.5 transition';
          notesTabMistakes.className = 'notes-subtab-btn px-4 py-2 rounded-xl text-xs font-bold bg-slate-100 text-slate-600 hover:bg-slate-200 flex items-center gap-1.5 transition';
          renderNotesTab();
        };

        document.getElementById('notes-clear-all-btn').onclick = () => {
          if (state.notesSubtab === 'mistakes') {
            state.mistakeIds.clear();
            showToast('오답 단어 목록이 초기화되었습니다.');
          } else {
            state.starredIds.clear();
            showToast('북마크 목록이 초기화되었습니다.');
          }
          persistState();
          renderNotesTab();
        };

        document.getElementById('notes-start-practice-btn').onclick = () => {
          const targetIds = state.notesSubtab === 'mistakes' ? state.mistakeIds : state.starredIds;
          const words = allWords.filter(w => targetIds.has(w.id));
          if (words.length < 4) {
            showToast('퀴즈를 진행하려면 최소 4개 이상의 단어가 필요합니다.', 'warning');
            return;
          }
          switchTab('quiz');
          startQuiz(words);
        };

        // Info Modal
        const infoModal = document.getElementById('info-modal');
        document.getElementById('info-modal-btn').onclick = () => infoModal.classList.remove('hidden');
        document.getElementById('close-info-modal-btn').onclick = () => infoModal.classList.add('hidden');
        document.getElementById('confirm-info-modal-btn').onclick = () => infoModal.classList.add('hidden');
        document.getElementById('reset-all-data-btn').onclick = () => {
          state.masteredIds.clear();
          state.starredIds.clear();
          state.mistakeIds.clear();
          persistState();
          infoModal.classList.add('hidden');
          renderWordList();
          showToast('모든 학습 데이터가 초기화되었습니다.', 'info');
        };

        // Keyboard Shortcuts
        window.addEventListener('keydown', (e) => {
          if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA') return;

          if (state.activeTab === 'flashcard') {
            if (e.code === 'Space') {
              e.preventDefault();
              flipFlashcard();
            } else if (e.code === 'ArrowRight') {
              nextFlashcard();
            } else if (e.code === 'ArrowLeft') {
              prevFlashcard();
            } else if (e.key === 'r' || e.key === 'R' || e.key === 'ㄱ') {
              const item = flashcardList[state.fcIndex];
              if (item) speakWord(item.word);
            }
          }
        });
      }

      // Expose speakWord globally for inline handlers
      window.speakWord = (encoded) => speakWord(decodeURIComponent(encoded));

      // --- Initialization ---
      setupEvents();
      updateHeaderStats();
      renderWordList();

    })();
  </script>
</body>
</html>
